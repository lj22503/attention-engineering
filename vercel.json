{
  "version": 2,
  "builds": [
    {
      "src": "website/**/*.{html,css,js,png,jpg,jpeg,svg,ico,webp}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/website/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}