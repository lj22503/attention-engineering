{
  "version": 2,
  "name": "attention-engineering",
  "builds": [
    {
      "src": "website/**/*.{html,css,js,png,jpg,jpeg,svg,ico}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/js/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/website/$1"
    }
  ]
}
